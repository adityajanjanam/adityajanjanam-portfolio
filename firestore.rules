rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to feedback data
    // Only allow writes with valid device ID
    match /feedback/{document=**} {
      allow read: if true; // Anyone can read vote counts
      allow write: if request.auth == null; // Allow anonymous writes
    }
    
    // Allow public read access to visitor data
    match /visitors/{document=**} {
      allow read: if true; // Anyone can read visitor counts
      allow write: if request.auth == null; // Allow anonymous writes
    }
  }
}
